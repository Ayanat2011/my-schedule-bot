# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Также поддерживается BOT_TOKEN (для обратной совместимости)
# BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Настройки подключения к базе данных:
# Локально по умолчанию (встроенная база данных SQLite):
DATABASE_URL=sqlite+aiosqlite:///./schedule_bot.db

# Для PostgreSQL (Docker или внешний сервер):
# DATABASE_URL=postgresql+asyncpg://schedule_user:schedule_password@localhost:5432/schedule_bot_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=schedule_user
DB_PASSWORD=schedule_password
DB_NAME=schedule_bot_db

# ID администраторов Telegram через запятую (например: 123456789,987654321)
ADMIN_IDS=123456789

# Часовой пояс по умолчанию
DEFAULT_TIMEZONE=Europe/Moscow

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Интервал проверки напоминаний в секундах (по умолчанию 30)
SCHEDULER_CHECK_INTERVAL=30
